  "complement_pca": {
    "basis_count": "min(16,numerical_rank(C))",
    "fit_roles": [
      "inner_train"
    ],
    "labels_used": false,
    "numeric_rank_rule": "singular value > max(s0*1e-6,1e-8)"
  },
  "data_exclusion": {
    "allowed_roles": [
      "inner_train",
      "discovery"
    ],
    "final_heldout_eeg_arrays": false,
    "outer_dev_arrays": false
  },
  "historical_provenance_caveat": "The canonical selected checkpoints have historical diagnostic evaluations on final-heldout subjects recorded in the source manifest. This experiment performs zero final-heldout EEG array reads and does not erase that historical exposure.",
  "identity_tolerances": {
    "alpha_one": "assert source no-op, then reuse native successor and native logits to avoid batch-size-dependent convolution roundoff",
    "logits_max_abs": 1e-06,
    "predictions": "exact",
    "representation_max_abs": 1e-06
  },
  "intervention": "one C direction scaled; pass through frozen source-to-successor block; replace successor P by candidate P and keep native successor C fixed; then frozen suffix",
  "local_actionability": {
    "D_margin": "(mean margin(alpha=1.25)-mean margin(alpha=0.75))/0.5",
    "U_P": "mean true-class margin(alpha=1)-mean true-class margin(alpha=0)",
    "conditional": "same subject/session/direction has >=10% trials with alpha*<1 and >=10% with alpha*>1"
  },
  "observability_targets": [
    "baseline correctness",
    "oracle action class for top-1 train-utility direction",
    "per-trial best true-margin gain over native"
  ],
  "oracle": {
    "oracle_1dir": "per trial maximize true-class margin over all C directions and fixed alpha grid; tie closest to 1, then smaller alpha, then lower direction index",
    "oracle_top3": "three directions ranked by descending absolute inner-train subject-equal U_P, ties by local direction index; sequential trial-specific true-margin alpha, K fixed at 3",
    "random_oracle": "one-direction oracle over deterministic equal-rank Gaussian-QR basis drawn in the source C complement"
  },
  "projector": {
    "discovery_labels_used": false,
    "heldout_labels_used": false,
    "protocol": "TRAIN-only subject-session-label centroids; standardized PathFit ridge alpha=1.0; recover raw-unit column space; reduced QR orthogonalization",
    "source_and_successor_stage_projectors_refit": true,
    "target": "frozen SIRE PERSIST/PEEH protected canonical coordinates from the historical source record; spectrum is reconstructed from current inner-train SIRE embeddings only"
  },
  "router": {
    "actions": {
      "ENHANCE": "alpha*>=1.5",
      "KEEP": "0.75<=alpha*<=1.25",
      "SUPPRESS": "alpha*<=0.5"
    },
    "apply_alpha_by_action": {
      "ENHANCE": 1.5,
      "KEEP": 1.0,
      "SUPPRESS": 0.5
    },
    "family": "StandardScaler + LogisticRegression(C=1,class_weight=balanced,max_iter=500,solver=lbfgs,random_state=0)",
    "feature_compression": "if raw feature dimension exceeds matched EEGNet feature budget, StandardScaler->PCA(n=budget, full SVD)->StandardScaler; fitted within each training split only",
    "inner_cv": "GroupKFold(min(5, number of inner-train subjects))",
