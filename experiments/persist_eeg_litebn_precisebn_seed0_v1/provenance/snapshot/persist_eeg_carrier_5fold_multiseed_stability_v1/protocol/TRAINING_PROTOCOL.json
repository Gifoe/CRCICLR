{
  "batch_size": 64,
  "bootstrap": {
    "resamples": 10000,
    "seed": 0,
    "unit": "subject"
  },
  "checkpoint_selection": "inner future-session mean-subject BA, eligible epochs 10..60, earliest tie",
  "datasets": [
    "OpenBMI",
    "WBCIC"
