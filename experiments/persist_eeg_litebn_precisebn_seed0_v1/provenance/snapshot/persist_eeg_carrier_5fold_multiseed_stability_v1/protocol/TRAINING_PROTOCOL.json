  "models": [
    "EEGNet",
    "LiteBN"
  ],
  "optimizer": "AdamW",
  "primary_unit": "subject",
  "scheduler": "none",
  "seeds": [
    0,
    1,
    2
  ],
  "weight_decay": 0.0005
}
